# Packaging Android (Capacitor) — 237 Mo de build local, dont un APK de
# 58 Mo. Versionner ça alourdit le dépôt pour toujours et GitHub s'en
# plaint. Le packaging vit sur sa propre branche (feat/android-capacitor).
android/

# Contient la phrase de passe de la console Sentinelle en clair.
# Le depot est public : ce fichier ne doit JAMAIS y entrer.
A_LANCER_PRIVE.sql

# Fichiers de travail temporaires (scripts de patch, verifications).
# Motif LARGE a dessein : la liste nominative laissait passer chaque
# nouveau nom (_bonus.py est arrive jusqu'a un commit). Tout fichier
# prefixe d'un underscore a la racine est un outil de session, jamais
# du code de l'app — celui-ci vit dans src/.
_*.py
_*.mjs
_*.js
_*.jsx
_*.sh
.verif/

# Supabase CLI — état local du lien, jamais versionné
supabase/.temp/
supabase/.branches/
